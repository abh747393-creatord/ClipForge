# ClipForge settings — copy to .env and adjust. Everything is optional.

# Address the web UI listens on (127.0.0.1 = this machine only).
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8780

# Where jobs, uploads, live buffers and clips are stored.
CLIPFORGE_DATA_DIR=./data

# Whisper speech model for local transcription (downloaded on first use).
CLIPFORGE_ASR_MODEL=large-v3-turbo

# Optional AI (LLM) for smarter clip picks and titles — any OpenAI-compatible
# endpoint, e.g. a local Ollama at http://127.0.0.1:11434/v1. Leave empty to
# run fully offline on heuristics. Can also be set in the Settings tab.
CLIPFORGE_LLM_BASE_URL=
CLIPFORGE_LLM_MODEL=
CLIPFORGE_LLM_KEY=

# Video encoder: leave empty for auto (GPU if available, else libx264).
# Force one with e.g. CLIPFORGE_ENCODER=x264 or nvenc.
CLIPFORGE_ENCODER=
